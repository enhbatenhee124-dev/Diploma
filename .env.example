# ------------------------------
# Supabase
# ------------------------------
# Локал хөгжүүлэлт: `npx supabase start` ажиллуулаад гарах утгуудыг хуулна.
# Продакшн: supabase.com дээрх төслийн Settings → API хэсгээс авна.

# Frontend-д хэрэглэгдэнэ (VITE_ угтвартай нь bundle-д ОРНО — энэ зүгээр,
# anon key нь нийтийн зориулалттай бөгөөд RLS хамгаална)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Сервер талд хэрэглэгдэнэ
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ⚠⚠ SERVICE ROLE түлхүүр нь RLS-ийг БҮРЭН ТОЙРНО — өгөгдлийн сангийн эзний эрх.
#    Хэзээ ч frontend-д битгий тавь. VITE_ угтвар БИТГИЙ хэрэглэ.
#    Задарвал шууд Supabase-ээс rotate хий.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------
# QPay (төлбөр)
# ------------------------------
# QPay-тэй мерчант гэрээ байгуулсны дараа өгөгдөнө.
# Тохируулаагүй үед нэхэмжлэл үүснэ ч QR гарахгүй — админ гараар баталгаажуулна.
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=

# QPay бидэн рүү мэдэгдэл илгээх хаяг. Интернэтээс хандах боломжтой байх ёстой.
# Локал турших бол ngrok гэх мэт ашиглана.
QPAY_CALLBACK_URL=https://taniiy-domain.mn/api/billing/qpay/callback

# ------------------------------
# Stripe (олон улсын карт) — ЗӨВХӨН ТУРШИЛТЫН ГОРИМ
# ------------------------------
# Dashboard → Developers → API keys → "Test mode" асаагаад нууц түлхүүрээ авна.
# ⚠ `sk_live_` түлхүүрийг сервер ЗОРИУДААР няцаана — энэ төсөл бодит мөнгө
#   хүлээж авахад шаардлагатай зүйлсийг (татвар, буцаалт, маргаан) хараагүй.
STRIPE_SECRET_KEY=sk_test_...

# Webhook нууц: `stripe listen --forward-to localhost:3001/api/billing/stripe/webhook`
# командын хэвлэх `whsec_...` утга. Продакшнд Dashboard → Webhooks-оос авна.
STRIPE_WEBHOOK_SECRET=whsec_...

# Таны Stripe данс МНТ дэмждэг бол `mnt` болгоно. Үгүй бол доорх ханшаар
# хөрвүүлнэ (⚠ үзүүлэнгийн тогтмол ханш — бодит үйлчилгээнд API-аас авна).
STRIPE_CURRENCY=usd
STRIPE_MNT_PER_UNIT=3600

# ------------------------------
# Сервер
# ------------------------------
# API серверийн порт (Vite нь /api-г энэ рүү дамжуулна)
PORT=3001

# 'production' үед HSTS толгой нэмэгдэж, алдааны дэлгэрэнгүй нуугдана
NODE_ENV=development

# API руу хандахыг зөвшөөрөх домэйнүүд (таслалаар тусгаарлана).
# Хөгжүүлэлтэд хоосон орхиж болно — localhost:5173 / :4173 анхдагчаар орно.
# ⚠ Продакшнд ЗААВАЛ бөглөнө. Үгүй бол дурын сайт хэрэглэгчийн нэрийн
#   өмнөөс API дуудах эрсдэлтэй.
CORS_ORIGINS=

# Frontend-ээс API-г хаанаас хайхыг заана.
# Хоосон үед `/api` (нэг домэйн эсвэл Vite proxy) ашиглана.
# FE, BE тусдаа домэйнд байрлавал бүтэн хаягийг бич:
#   VITE_API_URL=https://api.taniiy-domain.mn/api
VITE_API_URL=

# ------------------------------
# Push мэдэгдэл (FCM) — заавал биш
# ------------------------------
# Хоосон үед push чимээгүй унтарна. Аппын доторх мэдэгдэл (хонх) хэвээр
# ажиллах тул юу ч эвдрэхгүй (NFR-6).

# Firebase Console → Project settings → Service accounts → Generate new
# private key. Татсан JSON файлын БҮХ агуулгыг НЭГ МӨРӨНД буулгаж тавина.
# ⚠ Хувийн түлхүүр агуулна — SUPABASE_SERVICE_ROLE_KEY шиг нууц.
FCM_SERVICE_ACCOUNT=

# Supabase-ийн Database Webhook нь нэвтрэлтгүй ирдэг тул түүнийг таних
# хуваалцсан нууц. Санамсаргүй урт мөр үүсгэ:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Яг ижил утгыг Supabase-ийн webhook толгойд (x-webhook-secret) бичнэ.
PUSH_HOOK_SECRET=

# ------------------------------
# Android апп (Capacitor)
# ------------------------------
# Аппын дотор хуудас `https://localhost`-оос ачаалагддаг тул харьцангуй зам
# ажиллахгүй. Доорх хоёрыг ЗААВАЛ бүтэн хаягаар бөглөнө (`npm run app:sync`
# ажиллуулахаас өмнө). Хоосон үед `config/runtime.js`-ийн анхдагч утга орно.

# И-мэйлийн линк, хуваалцсан холбоос хаашаа заахыг тодорхойлно
VITE_PUBLIC_WEB_URL=https://ajil-iota.vercel.app

# Аппаас API руу хандах бүтэн хаяг. Хоосон бол VITE_PUBLIC_WEB_URL + /api
VITE_NATIVE_API_URL=
