# EmailJS тохиргоо — нэвтрэх үед сэрэмжлүүлэг и-мэйл илгээхэд хэрэглэнэ.
#
# Авах алхмууд:
#   1. https://www.emailjs.com дээр бүртгэл үүсгэнэ (үнэгүй багц сард 200 и-мэйл).
#   2. Email Services -> Add New Service -> Gmail (эсвэл өөр) холбоно -> Service ID хуулна.
#   3. Email Templates -> Create New Template. Загвар дотор дараах хувьсагчдыг ашиглана:
#        {{to_name}} {{to_email}} {{user_role}} {{login_method}} {{login_time}} {{message}}
#      Template-ийн "To Email" талбарт {{to_email}} гэж бичнэ. -> Template ID хуулна.
#   4. Account -> General -> Public Key хуулна.
#   5. Энэ файлыг `.env` нэрээр хуулж, доорх утгуудыг өөрийн түлхүүрээр солино.
#
# ⚠ Эдгээр түлхүүр frontend бandle дотор ил гарна. EmailJS-ийн Public Key нь
#   зориудаар нийтийн боловч, EmailJS-ийн тохиргооноос заавал domain хязгаарлалт
#   (Allowed Origins) тавьж өгөөрэй. .env файлыг git-д бүү оруул.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=


# ------------------------------
# Supabase
# ------------------------------
# Локал хөгжүүлэлт: `npx supabase start` ажиллуулаад гарах утгуудыг хуулна.
# Продакшн: supabase.com дээрх төслийн Settings → API хэсгээс авна.

# Frontend-д хэрэглэгдэнэ (VITE_ угтвартай нь bundle-д ОРНО — энэ зүгээр,
# anon key нь нийтийн зориулалттай бөгөөд RLS хамгаална)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Сервер талд хэрэглэгдэнэ
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ⚠⚠ SERVICE ROLE түлхүүр нь RLS-ийг БҮРЭН ТОЙРНО — өгөгдлийн сангийн эзний эрх.
#    Хэзээ ч frontend-д битгий тавь. VITE_ угтвар БИТГИЙ хэрэглэ.
#    Задарвал шууд Supabase-ээс rotate хий.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------
# QPay (төлбөр)
# ------------------------------
# QPay-тэй мерчант гэрээ байгуулсны дараа өгөгдөнө.
# Тохируулаагүй үед нэхэмжлэл үүснэ ч QR гарахгүй — админ гараар баталгаажуулна.
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=

# QPay бидэн рүү мэдэгдэл илгээх хаяг. Интернэтээс хандах боломжтой байх ёстой.
# Локал турших бол ngrok гэх мэт ашиглана.
QPAY_CALLBACK_URL=https://taniiy-domain.mn/api/billing/qpay/callback

# ------------------------------
# Сервер
# ------------------------------
# API серверийн порт (Vite нь /api-г энэ рүү дамжуулна)
PORT=3001

# 'production' үед HSTS толгой нэмэгдэж, алдааны дэлгэрэнгүй нуугдана
NODE_ENV=development

# API руу хандахыг зөвшөөрөх домэйнүүд (таслалаар тусгаарлана).
# Хөгжүүлэлтэд хоосон орхиж болно — localhost:5173 / :4173 анхдагчаар орно.
# ⚠ Продакшнд ЗААВАЛ бөглөнө. Үгүй бол дурын сайт хэрэглэгчийн нэрийн
#   өмнөөс API дуудах эрсдэлтэй.
CORS_ORIGINS=

# Frontend-ээс API-г хаанаас хайхыг заана.
# Хоосон үед `/api` (нэг домэйн эсвэл Vite proxy) ашиглана.
# FE, BE тусдаа домэйнд байрлавал бүтэн хаягийг бич:
#   VITE_API_URL=https://api.taniiy-domain.mn/api
VITE_API_URL=
