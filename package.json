{
  "name": "job-platform-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "start": "node server/index.js",
    "db:seed": "node --env-file-if-exists=.env server/scripts/seed.js",
    "db:refresh": "node --env-file-if-exists=.env server/scripts/refreshDemo.mjs",
    "account": "node --env-file-if-exists=.env server/scripts/createAccount.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "cors": "^2.8.6",
    "date-fns": "^2.30.0",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.4",
    "recharts": "^2.10.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "postcss": "^8.5.22",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "vite": "^4.5.0",
    "vitest": "^4.1.10"
  }
}
